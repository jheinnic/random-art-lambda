{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "../src/app/shared/di/*.yaml",
        "outDir": "./dist/app/shared/di/"
      },
      {
        "include": "../src/painting/artwork/components/genjs6.js",
        "outDir": "./dist/painting/artwork/components/"
      },
      {
        "include": "../src/painting/artwork/components/randomart/*",
        "outDir": "./dist/painting/artwork/components/randomart/"
      },
      {
        "include": "../src/plotting/protobuf/components/pb*.js",
        "outDir": "./dist/plotting/protobuf/components/"
      }
    ]
  }
}
