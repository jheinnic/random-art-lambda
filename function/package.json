{
    "name": "random-art-lambda",
    "version": "1.0.0",
    "description": "This pattern creates an Amazon API Gateway REST API with Request Validator and an AWS Lambda function.",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "prebuild": "rimraf dist",
        "brokeBuild": "nest build",
        "build": "tsc -b",
        "badBuild": "tsc -b && cp build/src/plotting/protobuf/plot_mapping_pb.mjs build/src/plotting/protobuf/plot_mapping_pb.js",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "runCli": "node ./build/cli/main.js plot",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint '{src,apps,libs,test}/**/*.ts' --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "echo 'No e2e tests implemented yet.'"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jheinnic/random-art-lambda.git"
    },
    "keywords": [],
    "engines": {
        "node": ">=20.19.3"
    },
