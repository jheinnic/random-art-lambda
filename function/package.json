{
   "name": "random-art-lambda",
   "version": "1.0.0",
   "description": "This pattern creates an Amazon API Gateway REST API with Request Validator and an AWS Lambda function.",
   "main": "index.js",
   "type": "module",
   "scripts": {
      "prebuild": "rimraf dist",
      "brokeBuild": "nest build",
      "build": "tsc -p tsconfig.json; npm run copyRAJs; npm run copyPBuf; npm run copyYaml; npm run copyGenJs",
      "clean": "rm -rf build",
      "cleanBuild": "npm run clean && npm run build",
      "copyGenJs": "for f in src/painting/artwork/components/genjs6.*; do [ -e \"$f\" ] && cp \"$f\" dist/painting/artwork/components/; done; :;",
      "copyPBuf": "cp src/plotting/protobuf/components/plot_mapping_pb* dist/plotting/protobuf/components/",
      "copyRAJs": "cp -r src/painting/artwork/components/randomart dist/painting/artwork/components/randomart",
      "copyYaml": "cp src/app/shared/di/*yaml dist/app/shared/di",
      "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
      "runCli": "node -r tsconfig-paths/register ./dist/cli/main.js plot",
      "start": "nest start",
      "start:dev": "nest start --watch",
      "start:debug": "nest start --debug --watch",
      "start:prod": "node -r tsconfig-paths/register dist/main",
      "lint": "eslint '{src,apps,libs,test}/**/*.ts' --fix",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:cov": "jest --coverage",
      "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
      "test:e2e": "echo 'No e2e tests implemented yet.'"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/jheinnic/random-art-lambda.git"
   },
   "keywords": [],
   "engines": {
      "node": ">=20.19.3"
   },
   "author": "",
   "license": "MIT",
   "bugs": {
      "url": "https://github.com/jheinnic/random-art-lambda/issues"
   },
   "homepage": "https://github.com/jheinnic/random-art-lambda#readme",
