import { DynamicModule, Injectable, OnModuleInit } from "@nestjs/common"
import { Nominal } from "../messages/index.js"
import { AssertEqual } from "zod/v4/core/util"

const ChainArtifactType: unique symbol = Symbol("ChainArtifactName")
type ChainArtifactName<Names extends string = string> = Nominal<
   Names,
   typeof ChainArtifactType
>

type ChainArtifact<
   Contract extends (...args: any[]) => any,
   Names extends string,
   ElementName extends ChainArtifactName<Names> = ChainArtifactName<Names>,
> = {
   [Name in ElementName]: Contract
}

type ChainArtifactMap<
   Contract extends (...args: any[]) => any,
   Names extends string = string,
   ActualNames extends ChainArtifactName<Names> = ChainArtifactName<Names>,
> = {
   [Name in ActualNames]: ChainArtifact<Contract, Names, Name>
}

type ResponsibilityChain<
   Contract extends (...args: any[]) => any,
   Names extends string = string,
   ActualNames extends ChainArtifactName<Names> = ChainArtifactName<Names>,
> = (...args: Parameters<Contract>) => {
   [Name in ActualNames]: ReturnType<Contract>
}

type PartialNameOrder<Names extends string = string> =
   AssertEqual<Names, never> extends false
      ? _PartialNameOrder<Names, Names> | []
      : []
type _PartialNameOrder<
   Names extends string,
   Rest extends string,
> = Names extends Names
   ? AssertEqual<Exclude<Rest, Names>, never> extends true
      ? [Names]
      :
           | [Names]
           | [
                Names,
                ..._PartialNameOrder<
                   Exclude<Rest, Names>,
                   Exclude<Rest, Names>
                >,
             ]
   : never

