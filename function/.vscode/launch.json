   "version": "0.2.0",
   "configurations": [
      {
         "name": "ts-node",
         "type": "pwa-node",
         "request": "launch",
         "args": ["${relativeFile}"],
         "runtimeArgs": ["-r", "ts-node/register"],
         "cwd": "${workspaceRoot}",
         "internalConsoleOptions": "openOnSessionStart"
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "Launch Built Main",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "/home/ionadmin/.nvm/versions/node/v20.19.3/bin/node",
         "program": "${workspaceFolder}/build/app/components/Main.js",
         "outFiles": ["${workspaceFolder}/build/**/*.js"],
         "env": {
            "UNIQUE_ID": "peon",
            "RA_APP_ROLES": "[\"mainApp\", \"stageWorker\", \"paintWorker\"]"
         }
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "Launch app/trigram-permutation/cli/submit-project.js",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/app/trigram-permutation/cli/submit-project.ts --blockstore-path /home/ionadmin/Documents/mapBlocks --dry-run ${workspaceFolder}/bagua-spec.json",
         "outFiles": ["${workspaceFolder}/dist/**/*.js"],
         "env": {
            "UNIQUE_ID": "peon",
            "RA_APP_ROLES": "[\"mainApp\", \"stageWorker\", \"paintWorker\"]"
            // "NESTJS_DEBUG": 1,
            // "NEST_DEBUG": 1,
            // "DEBUG_NESTJS": 1,
            // "DEBUG_NEST": 1
         }
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "Launch app/components/Main.ts",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/app/components/Main.ts",
         "outFiles": ["${workspaceFolder}/build/**/*.js"],
         "env": {
            "UNIQUE_ID": "peon",
            "RA_APP_ROLES": "[\"mainApp\", \"stageWorker\", \"paintWorker\"]"
            // "NESTJS_DEBUG": 1,
            // "NEST_DEBUG": 1,
            // "DEBUG_NESTJS": 1,
            // "DEBUG_NEST": 1
         }
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "Lunch Program",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/cli/main.ts plot",
         "outFiles": ["${workspaceFolder}/build/**/*.js"]
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "Basic Tester",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/cli/basic.ts",
         "outFiles": ["${workspaceFolder}/build/**/*.js"]
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "Old Main Tester",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/app/components/Main.ts",
         "outFiles": ["${workspaceFolder}/build/**/*.js"]
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "InToy3A",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/InToy3A.ts",
         "outFiles": ["${workspaceFolder}/build/**/*.js"]
      },
      {
         "type": "pwa-node",
         "request": "launch",
         "name": "InToy5",
         "skipFiles": ["<node_internals>/**"],
         "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
         "program": "${workspaceFolder}/src/InToy5.ts",
         "outFiles": ["${workspaceFolder}/build/**/*.js"]
      }
   ]
}
