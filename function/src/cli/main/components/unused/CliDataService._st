// src/cli-data.service.ts
import { Injectable } from '@nestjs/common';

/**
 * A service to hold and resolve the command-line data asynchronously.
 * This allows the CLI command to set the data *after* arguments are parsed,
 * and for dependent services to *wait* for that data before being fully initialized.
 */
@Injectable()
export class CliDataService {
  private cliDataPromise: Promise<string>;
  private resolveCliData: (data: string) => void;

  constructor() {
    // Initialize the promise. The 'resolve' function is stored to be called later.
    this.cliDataPromise = new Promise((resolve) => {
      this.resolveCliData = resolve;
    });
  }

  /**
   * Returns a promise that will resolve with the command-line data.
   * Other services will 'await' this promise in their factory providers.
   */
  get data(): Promise<string> {
    return this.cliDataPromise;
  }

  /**
   * Sets the command-line data and resolves the internal promise.
   * This method is called from your command runner after parsing arguments.
   * @param data The string data parsed from the command line.
   */
  setData(data: string) {
    if (this.resolveCliData) {
      this.resolveCliData(data);
    }
  }
}

// src/network-adapter.interface.ts
/**
 * Defines the interface for our network-agnostic adapter.
 * This helps maintain loose coupling.
 */
export interface INetworkAdapter {
  fetchData(): Promise<string>;
  configure(data: string): void;
}

// src/network-adapter.ts
import { Injectable } from '@nestjs/common';
import { INetworkAdapter } from './network-adapter.interface';

/**
 * A concrete implementation of the network adapter.
 * Its configuration depends on the data provided asynchronously.
 */
@Injectable()
export class NetworkAdapter implements INetworkAdapter {
  private configData: string;

  constructor(initialData: string = 'default_config') {
    this.configData = initialData;
    console.log(`NetworkAdapter initialized with: ${this.configData}`);
    // IMPORTANT: Avoid reading dynamic values in the constructor if they are
    // only available after CLI input. Use the configure method instead.
  }

  /**
   * Configures the adapter with new data. This is typically called
   * after the async factory resolves the CLI input.
   * @param data The configuration data from the CLI.
   */
  configure(data: string): void {
    this.configData = data;
    console.log(`NetworkAdapter reconfigured with: ${this.configData}`);
  }

  async fetchData(): Promise<string> {
    // Simulate network call using the configured data
    return `Data fetched using: ${this.configData}`;
  }
}

// src/my.service.ts
import { Injectable, Inject } from '@nestjs/common';
import { INetworkAdapter } from './network-adapter.interface';

/**
 * A service that depends on the network adapter.
 * It will receive the fully configured adapter instance.
 */
@Injectable()
export class MyService {
  constructor(@Inject('NETWORK_ADAPTER') private readonly networkAdapter: INetworkAdapter) {
    console.log('MyService instantiated with NetworkAdapter.');
  }

  /**
   * Performs some operation using the network adapter.
   */
  async performNetworkOperation(): Promise<string> {
    console.log('MyService is performing a network operation...');
    const result = await this.networkAdapter.fetchData();
    return `Service Operation Result: ${result}`;
  }
}
