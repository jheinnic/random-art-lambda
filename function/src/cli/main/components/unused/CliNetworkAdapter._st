// src/cli/network-adapter-cli.ts (CLI specific implementation of NetworkAdapter)
import { Injectable, Scope } from "@nestjs/common" // Import Scope
import { INetworkAdapter } from "../common/network-adapter.interface"

/**
 * A concrete implementation of the network adapter for the CLI environment.
 * It is TRANSIENT scoped, meaning a new instance is created every time it's resolved.
 * Its initial configuration depends on data provided at the time of resolution.
 */
@Injectable({ scope: Scope.TRANSIENT }) // Make it TRANSIENT scoped
export class CliNetworkAdapter implements INetworkAdapter {
   private configData: string

   // Constructor now directly receives configData, which will be passed via ModuleRef.resolve arguments.
   constructor(configData: string = "default_cli_config_from_transient") {
      this.configData = configData
      console.log(
         `CliNetworkAdapter (TRANSIENT) initialized with: ${this.configData}`,
      )
   }

   configure(data: string): void {
      this.configData = data
      console.log(
         `CliNetworkAdapter (TRANSIENT) reconfigured with: ${this.configData}`,
      )
   }

   async fetchData(): Promise<string> {
      // Simulate network call using the configured data for CLI
      return `CLI Data fetched using: ${this.configData}`
   }
}
