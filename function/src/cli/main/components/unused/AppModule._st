// src/app.module.ts
import { Module } from "@nestjs/common"
import { MyCommand } from "./my.command"
import { CliDataService } from "./cli-data.service"
import { NetworkAdapter, INetworkAdapter } from "./network-adapter"
import { MyService } from "./my.service"

@Module({
   imports: [], // Import CommandModule for CLI functionality
   providers: [
      CliDataService, // Provide our async data holding service
      {
         provide: "NETWORK_ADAPTER", // Use a custom token for the adapter
         useFactory: async (
            cliDataService: CliDataService,
         ): Promise<INetworkAdapter> => {
            console.log("NETWORK_ADAPTER factory is waiting for CLI data...")
            // Wait for the CLI data to be set.
            // This pauses the dependency graph resolution for anything that
            // depends on 'NETWORK_ADAPTER' until setData() is called.
            const data = await cliDataService.data
            console.log(`NETWORK_ADAPTER factory received data: ${data}`)

            // Create and configure the adapter instance with the received data.
            const adapter = new NetworkAdapter(data)
            // If the NetworkAdapter constructor itself doesn't take the dynamic data,
            // you would call a 'configure' method here:
            // const adapter = new NetworkAdapter();
            // adapter.configure(data);
            return adapter
         },
         inject: [CliDataService], // The factory needs access to CliDataService
      },
      MyService, // MyService depends on 'NETWORK_ADAPTER', so it will be
      // instantiated only after the factory resolves.
      MyCommand, // Register your command
   ],
})
export class AppModule {}
