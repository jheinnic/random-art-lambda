// src/web/network-adapter-web.ts (Web specific implementation of NetworkAdapter)
import { Injectable, Scope, Inject, Request } from "@nestjs/common"
import { INetworkAdapter } from "../common/network-adapter.interface"
import { Request as ExpressRequest } from "express" // Assuming Express is the underlying platform

/**
 * A concrete implementation of the network adapter for the Web environment.
 * It's scoped to the request, meaning a new instance is created for each HTTP request.
 * Its configuration depends on data available in the HTTP Request object.
 */
@Injectable({ scope: Scope.REQUEST }) // Important: This adapter is request-scoped
export class WebNetworkAdapter implements INetworkAdapter {
   private configData: string

   constructor(@Inject(Request) private readonly request: ExpressRequest) {
      // In a real web app, you might get config from headers, query params, etc.
      // For demonstration, we'll use a custom header 'x-app-config'.
      this.configData =
         // eslint-disable-next-line @typescript-eslint/strict-boolean-expressions
         this.request.headers["x-app-config"]?.toString() ||
         "default_web_config_from_request"
      console.log(
         `WebNetworkAdapter initialized with: ${this.configData} from HTTP Request.`,
      )
   }

   configure(data: string): void {
      this.configData = data
      console.log(
         `WebNetworkAdapter reconfigured (runtime): ${this.configData}`,
      )
   }

   async fetchData(): Promise<string> {
      // Simulate network call using the configured data for Web
      return `Web Data fetched using: ${this.configData}`
   }
}
