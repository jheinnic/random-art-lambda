// src/web/app.controller.ts (A simple web controller)
import { Controller, Get, Headers, Inject, CONTEXT_ID } from '@nestjs/common'; // CONTEXT_ID is needed now
import { MyService } from '../common/my.service'; // MyService from the shared module
import { ContextId } from '@nestjs/core'; // Import ContextId

@Controller()
export class AppController {
  constructor(
    private readonly myService: MyService,
    @Inject(CONTEXT_ID) private readonly contextId: ContextId // Inject the current request ContextId
  ) {}

  @Get('/perform-web-op')
  async getWebOperation(@Headers('x-app-config') xAppConfig?: string): Promise<string> {
    console.log(`Web Controller: Received X-App-Config header: ${xAppConfig || 'Not Provided'}`);
    console.log('Web Controller: Performing web operation...');
    // Pass the contextId to MyService so it can resolve the request-scoped adapter.
    return await this.myService.performNetworkOperation(this.contextId);
  }
}