// src/cli/app.module.ts (CLI application's root module)
import { Module, Scope } from "@nestjs/common" // Import Scope
import { MyCliCommand } from "./my.command"
import { CliNetworkAdapter, INetworkAdapter } from "./network-adapter-cli" // CLI specific adapter
import { SharedNetworkModule } from "../shared-network/shared-network.module" // The dynamic shared module

@Module({
   imports: [
      // Register the SharedNetworkModule, providing the CLI-specific adapter implementation
      SharedNetworkModule.register({
         networkAdapterProvider: {
            provide: "NETWORK_ADAPTER", // Token that MyService expects
            useClass: CliNetworkAdapter, // Provide the CLI-specific TRANSIENT adapter
            scope: Scope.TRANSIENT, // Mark as TRANSIENT so new instance is created per resolve
         },
      }),
   ],
   providers: [
      MyCliCommand, // Register the CLI command
      // CliDataService is no longer needed here as configuration is passed directly to TRANSIENT adapter constructor
   ],
})
export class AppModuleCli {}
