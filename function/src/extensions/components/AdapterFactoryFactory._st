import { Type } from "@nestjs/common"
import { IAdapterFactory } from "../interface/IAdapterFactory.js"
import { IExtensionAdapterClass } from "../interface/IExtensionAdapterClass.js"
import { IAdapterFactoryFactory } from "../interface/IAdapterFactoryFactory.js"
import { AdapterFactory } from "./BasicAdapterFactory.js"
import { IAnyExtension } from "../interface/IExtension.js"
export class AdapterFactoryFactory implements IAdapterFactoryFactory {
   private factories: {
      [K in string]: Map<Type<any>, IAdapterFactory<string, any, any>>
   } = {}

   prepare<
      ExtensionPoint extends string,
      Extension extends IAnyExtension<ExtensionPoint>,
      AdapterType extends IExtensionAdapterClass<ExtensionPoint, Extension>,
   >(
      extensionPoint: ExtensionPoint,
      AdapterClass: AdapterType,
   ): IAdapterFactory<ExtensionPoint, Extension, AdapterType> {
      let adapters: Map<
         Type<any>,
         IAdapterFactory<ExtensionPoint, Extension, AdapterType>
      >
      if (extensionPoint in this.factories) {
         adapters = this.factories[extensionPoint]
      } else {
         adapters = new Map()
         this.factories[extensionPoint] = adapters as Map<
            Type<any>,
            IAdapterFactory<string, any, any>
         >
      }

      if (adapters.has(AdapterClass)) {
         return adapters.get(AdapterClass) as IAdapterFactory<
            ExtensionPoint,
            Extension,
            AdapterType
         >
      }
      const factory = new AdapterFactory<
         ExtensionPoint,
         Extension,
         AdapterType
      >(AdapterClass)
      adapters.set(AdapterClass, factory as IAdapterFactory<string, any, any>)
      return factory
   }
}
