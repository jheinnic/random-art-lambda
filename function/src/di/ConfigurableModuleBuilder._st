import {
   ConfigurableModuleBuilderOptions,
   ConfigurableModuleBuilder as OriginalBuilder,
} from "@nestjs/common"

// Reorder the generics to place TExtras in the second position
export class ConfigurableModuleBuilder<
   TModuleOptions,
   TExtras,
> extends OriginalBuilder<TModuleOptions, string, string, TExtras> {
   constructor(
      options: ConfigurableModuleBuilderOptions,
      registerMethodName: string = "register",
      factoryClassMethodName: string = "create",
   ) {
      super(options)
      this.setRegisterMethodName(registerMethodName).setFactoryClassMethodName(
         factoryClassMethodName,
      )
   }

   setRegisterMethodName(name: string): ConfigurableModuleBuilder {
      return this.setRegisterMethodName(name)
   }
}
