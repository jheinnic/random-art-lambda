import { registerFunction, default as evaluator } from 'ts-expression-evaluator'
const evaluate = evaluator.default

console.log(evaluate)

const context = {
  id: 10,
  name: 'FED',
  count: 10,
  staffs: [{
    id: 1,
    name: 'Tina'
  }, {
    id: 2,
    name: 'James'
  }],
}
 
// eval from context
// evaluate('name', context) // 'FED'
console.log(evaluate('staffs[0].name + staffs[1].name', context)) // 'Tina'
// evaluate('count + 10', context) // 20
 
// ===
// evaluate('count === 11', context) // false
