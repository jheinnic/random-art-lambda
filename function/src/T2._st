type ConfigBaseType = object

// Defines the generic constructor that takes an R type explicitly
export type GenericAdapterCtor<E extends string> = new <
   R extends ConfigBaseType,
>(
   ...args: any[]
) => IAdapter<E, R>

// Interface for the Adapter instance itself (using our old Foo/R relationship)
export interface IAdapter<E extends string, R extends ConfigBaseType> {
   process: (input: R) => string
   getConfig: () => R
}

// The core Factory interface definition
export interface IAdapterFactory<
   ExtensionPoint extends KnownExtensionPointIds,
   ConfigType extends ConfigBaseType,
   Adapter extends abstract new <T extends ConfigType>(
      ...args: any
   ) => IAdapter<ExtensionPoint, T>,
> {
   createAdapter: (config: ConfigType) => InstanceType<Adapter>
   configMetadata: Record<string, keyof ConfigType>
}

// Define a concrete Adapter class that is generic over its config type
class ConcreteAdapter<T> {
   constructor(private readonly config: T) {}
   public getInfo(): T {
      return this.config
   }
}

