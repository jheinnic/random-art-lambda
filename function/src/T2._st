// Define a concrete, instantiable constructor type
// Note the removal of 'abstract'
type ConcreteAdapterCtor<E extends string> = new <T extends ConfigBaseType>(
   ...args: any[]
) => IAdapter<E, T>

// The concrete factory class is updated to use the CONCRETE constructor constraint
class ConcreteAdapterFactory<
   C extends ConfigBaseType,
   // A now extends the *instantiable* constructor type, removing the 'abstract' constraint
   A extends ConcreteAdapterCtor<"api">,
> implements IAdapterFactory<"api", C, A>
{
   // AdapterCtor is now guaranteed to be a concrete constructor
   private readonly AdapterCtor: A

   // REQUIRED PROPERTY ADDED HERE
   // It must match the type: Record<string, keyof C>
   public configMetadata: Record<string, keyof C> = {} as any

   constructor(AdapterCtor: A) {
      this.AdapterCtor = AdapterCtor
   }

   createAdapter(config: C): InstanceType<A> {
      // This is now valid because AdapterCtor is not abstract
      return new this.AdapterCtor<C>(config) as InstanceType<A>
   }

   // ... rest of the class ...
}

// function createFactory<
//    C,
//    A extends abstract new <T extends C>(...args: any) => any,
// >(AdapterCtor: A): MyAdapterFactory<C, A> {
//    // TypeScript infers C and A based on the type of AdapterCtor
//    return new MyAdapterFactory(AdapterCtor)
// }

// The factory function is updated to use the CONCRETE constructor constraint
function createAdapterFactory<A extends ConcreteAdapterCtor<"api">>(
   AdapterCtor: A,
): ConcreteAdapterFactory<A> {
   // Inference works, and the returned factory knows A is instantiable
   return new ConcreteAdapterFactory(AdapterCtor)
}
